# Committed on purpose: local-only test credentials, no real secrets.
NODE_ENV=test
PORT=4001
DATABASE_URL=postgresql://fittrack:fittrack@localhost:5432/fittrack_test
REDIS_URL=redis://localhost:6379/1
CORS_ORIGINS=*
JWT_ACCESS_SECRET=test-secret-that-is-at-least-32-characters-long
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Object storage for photos. Local values match docker-compose.yml (SeaweedFS).
# For AWS S3: remove S3_ENDPOINT/S3_PUBLIC_ENDPOINT, set S3_FORCE_PATH_STYLE=false.
# Physical phone: set S3_PUBLIC_ENDPOINT=http://<your-Mac-LAN-IP>:8333
S3_ENDPOINT=http://localhost:8333
S3_PUBLIC_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=fittrack
S3_SECRET_ACCESS_KEY=fittrack-dev-secret
S3_FORCE_PATH_STYLE=true
S3_BUCKET=fittrack-test

PUBLIC_API_URL=http://localhost:4001
