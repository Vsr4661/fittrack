NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://fittrack:fittrack@localhost:5432/fittrack
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=*

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-random-string-of-at-least-32-chars
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Object storage for photos. Local values match docker-compose.yml (SeaweedFS).
# For AWS S3: remove S3_ENDPOINT/S3_PUBLIC_ENDPOINT, set S3_FORCE_PATH_STYLE=false.
# Physical phone: set S3_PUBLIC_ENDPOINT=http://<your-Mac-LAN-IP>:8333
S3_ENDPOINT=http://localhost:8333
S3_PUBLIC_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=fittrack
S3_SECRET_ACCESS_KEY=fittrack-dev-secret
S3_FORCE_PATH_STYLE=true
S3_BUCKET=fittrack

# How phones reach the API (absolute links in responses). Physical phone: your LAN IP
PUBLIC_API_URL=http://localhost:4000
