  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Ember fill with a white label; one per screen (Start workout, Save, Log in).",
      "html": "<button class=\"ds-btn-primary\">Start workout</button>",
      "css": ".ds-btn-primary{font-family: Inter, -apple-system, system-ui, sans-serif;min-height:48px;padding:0 16px;border:none;border-radius:12px;background:#D63F0A;color:#fff;font-weight:600;font-size:14px;line-height:18px;box-shadow:0 1px 3px rgba(15,23,42,.08);transition:transform .12s cubic-bezier(.2,.8,.2,1)}.ds-btn-primary:active{transform:scale(.97)}.ds-btn-primary:focus-visible{outline:2px solid #FF5A1F;outline-offset:2px}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Chalk Dust fill, Ink label; the quieter companion action.",
      "html": "<button class=\"ds-btn-secondary\">Add exercise</button>",
      "css": ".ds-btn-secondary{font-family: Inter, -apple-system, system-ui, sans-serif;min-height:48px;padding:0 16px;border:none;border-radius:12px;background:#F1F5F9;color:#111827;font-weight:600;font-size:14px;transition:transform .12s}.ds-btn-secondary:active{transform:scale(.97)}.ds-btn-secondary:focus-visible{outline:2px solid #FF5A1F;outline-offset:2px}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "No fill, Ember Text label; low-emphasis actions like See all.",
      "html": "<button class=\"ds-btn-ghost\">See all</button>",
      "css": ".ds-btn-ghost{font-family: Inter, -apple-system, system-ui, sans-serif;min-height:48px;padding:0 16px;border:none;border-radius:12px;background:transparent;color:#C93A08;font-weight:600;font-size:14px}.ds-btn-ghost:hover{background:#FFEDE5}.ds-btn-ghost:focus-visible{outline:2px solid #FF5A1F;outline-offset:2px}"
    },
    {
      "name": "Text Input",
      "kind": "input",
      "refersTo": "input",
      "description": "Labelled field with a 1.5pt border that turns Effort Orange on focus.",
      "html": "<label class=\"ds-field\"><span class=\"ds-field-label\">Name</span><input class=\"ds-input\" placeholder=\"Your name\"></label>",
      "css": ".ds-field{font-family: Inter, -apple-system, system-ui, sans-serif;display:flex;flex-direction:column;gap:6px}.ds-field-label{font-weight:600;font-size:14px;color:#111827}.ds-input{font-family: Inter, -apple-system, system-ui, sans-serif;min-height:50px;padding:0 14px;border:1.5px solid #E2E8F0;border-radius:12px;background:#fff;color:#111827;font-size:16px;outline:none;transition:border-color .15s}.ds-input::placeholder{color:#5B6B7F}.ds-input:focus,.ds-input:focus-visible{border-color:#FF5A1F}"
    },
    {
      "name": "Search Field",
      "kind": "input",
      "refersTo": "search-field",
      "description": "Borderless Chalk Dust search bar with a leading icon.",
      "html": "<div class=\"ds-search\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#5B6B7F\" stroke-width=\"2\" stroke-linecap=\"round\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"m20 20-3.5-3.5\"/></svg><input class=\"ds-search-input\" placeholder=\"Search exercises\"></div>",
      "css": ".ds-search{font-family: Inter, -apple-system, system-ui, sans-serif;display:flex;align-items:center;gap:8px;min-height:44px;padding:0 12px;border-radius:12px;background:#F1F5F9}.ds-search:focus-within{box-shadow:0 0 0 2px #FF5A1F}.ds-search-input{flex:1;border:none;background:transparent;font-size:16px;color:#111827;outline:none}.ds-search-input::placeholder{color:#5B6B7F}"
    },
    {
      "name": "Chips",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Pill filters; the selected one switches to an Ember fill.",
      "html": "<div class=\"ds-chips\"><button class=\"ds-chip ds-chip-selected\">3 / week</button><button class=\"ds-chip\">4 / week</button><button class=\"ds-chip\">5 / week</button></div>",
      "css": ".ds-chips{display:flex;gap:8px}.ds-chip{font-family: Inter, -apple-system, system-ui, sans-serif;min-height:36px;padding:6px 14px;border:none;border-radius:999px;background:#F1F5F9;color:#111827;font-weight:600;font-size:14px}.ds-chip:hover{background:#E2E8F0}.ds-chip-selected,.ds-chip-selected:hover{background:#D63F0A;color:#fff}.ds-chip:focus-visible{outline:2px solid #FF5A1F;outline-offset:2px}"
    },
    {
      "name": "Workout Card",
      "kind": "card",
      "refersTo": "card",
      "description": "Raised Surface White card on Chalk with a soft lift, title, badge and three stat tiles.",
      "html": "<div class=\"ds-card\"><div class=\"ds-card-head\"><span class=\"ds-card-title\">Push day</span><span class=\"ds-badge\">Everyone</span></div><div class=\"ds-stats\"><div class=\"ds-stat\"><b>48m</b><span>Duration</span></div><div class=\"ds-stat\"><b>6,240 kg</b><span>Volume</span></div><div class=\"ds-stat\"><b>18</b><span>Sets</span></div></div></div>",
      "css": ".ds-card{font-family: Inter, -apple-system, system-ui, sans-serif;background:#fff;border-radius:16px;padding:16px;display:flex;flex-direction:column;gap:12px;box-shadow:0 1px 3px rgba(15,23,42,.08);transition:transform .12s}.ds-card:active{transform:scale(.97)}.ds-card-head{display:flex;align-items:center;justify-content:space-between;gap:12px}.ds-card-title{font-weight:700;font-size:18px;line-height:24px;color:#111827}.ds-badge{padding:3px 8px;border-radius:999px;background:#F1F5F9;color:#5B6B7F;font-weight:600;font-size:12px;letter-spacing:.6px;text-transform:uppercase}.ds-stats{display:flex;gap:8px}.ds-stat{flex:1;display:flex;flex-direction:column;align-items:center;padding:12px 4px;border-radius:12px;background:#F1F5F9}.ds-stat b{font-size:18px;font-variant-numeric:tabular-nums;color:#111827}.ds-stat span{font-weight:500;font-size:13px;color:#5B6B7F}"
    },
    {
      "name": "Tab Bar",
      "kind": "nav",
      "refersTo": "tab-indicator",
      "description": "Four tabs; the active one sits in a sliding Ember Wash pill.",
      "html": "<nav class=\"ds-tabs\"><a class=\"ds-tab ds-tab-active\"><i></i>Home</a><a class=\"ds-tab\"><i></i>Feed</a><a class=\"ds-tab\"><i></i>Workouts</a><a class=\"ds-tab\"><i></i>Profile</a></nav>",
      "css": ".ds-tabs{font-family: Inter, -apple-system, system-ui, sans-serif;display:flex;background:#fff;padding:8px 0;border-top:1px solid #E2E8F0}.ds-tab{flex:1;display:flex;flex-direction:column;align-items:center;gap:2px;min-height:52px;font-weight:600;font-size:12px;color:#5B6B7F;cursor:pointer}.ds-tab i{width:56px;height:32px;border-radius:999px;background:transparent;transition:background .2s}.ds-tab-active{color:#C93A08}.ds-tab-active i{background:#FFEDE5}.ds-tab:hover i{background:#F1F5F9}.ds-tab-active:hover i{background:#FFEDE5}"
    },
    {
      "name": "Progress Ring",
      "kind": "custom",
      "refersTo": "effort-orange",
      "description": "Signature weekly-goal ring: Chalk Dust track, Effort Orange arc, tabular center number.",
      "html": "<div class=\"ds-ring\"><svg width=\"96\" height=\"96\" viewBox=\"0 0 96 96\"><circle cx=\"48\" cy=\"48\" r=\"43\" stroke=\"#F1F5F9\" stroke-width=\"10\" fill=\"none\"/><circle class=\"ds-ring-arc\" cx=\"48\" cy=\"48\" r=\"43\" stroke=\"#FF5A1F\" stroke-width=\"10\" fill=\"none\" stroke-linecap=\"round\" stroke-dasharray=\"270.2\" stroke-dashoffset=\"90\" transform=\"rotate(-90 48 48)\"/></svg><span>2/3</span></div>",
      "css": ".ds-ring{font-family: Inter, -apple-system, system-ui, sans-serif;position:relative;width:96px;height:96px;display:grid;place-items:center}.ds-ring svg{position:absolute;inset:0}.ds-ring span{font-weight:700;font-size:18px;font-variant-numeric:tabular-nums;color:#111827}.ds-ring-arc{transition:stroke-dashoffset .9s cubic-bezier(.33,1,.68,1)}.ds-ring:hover .ds-ring-arc{stroke-dashoffset:0}@media (prefers-reduced-motion: reduce){.ds-ring-arc{transition:none}}"
    }
  ],
  "narrative": {
    "northStar": "The Training Floor",
    "overview": "A good gym floor is calm. The walls are plain, the equipment is where you\nexpect it, and the only bright things are the ones that matter: the clock,\nthe plates, the person next to you hitting a lift. FitTrack's screens work\nthe same way. Surfaces are quiet Chalk (light) or Iron (dark), type is a\nsingle family set firmly, and orange appears only where effort happens:\nthe Start button, a completed ring, a streak, the active tab.\n\nThe app is used in two very different moments. Mid-workout, with sweaty hands\nand divided attention, everything must read at a glance and be hittable\nwithout aiming: big targets, numbers in tabular figures, one deliberate tick\nper set with a haptic to confirm it. Between workouts, the feed and profiles\ncan breathe a little more, but they stay inside the same calm world rather\nthan switching to a louder \"social\" skin.\n\nControls feel confident and tactile: solid fills, a slight shrink under the\nfinger, a real haptic on the moments that count. Depth is a soft lift, never\ndrama. The world is native on each platform where conventions differ (touch\ntargets, transient feedback, titles), and identical everywhere else.",
    "keyCharacteristics": [
      "Quiet slate surfaces; orange reserved for effort and the one primary action.",
      "Two oranges with strictly separate jobs: Effort Orange for graphics, Ember for fills with text.",
      "One typeface (Inter), heavy at the top of the hierarchy, tabular figures for every number.",
      "Large touch targets (44pt iOS / 48dp Android minimum) and text that scales with the OS setting.",
      "Soft lift in light mode, tonal layering plus hairline borders in dark mode.",
      "Contrast is measured on every surface a color sits on, not eyeballed."
    ],
    "rules": [
      {
        "name": "The Two Oranges Rule",
        "body": "Effort Orange draws; Ember carries words. If something has text on it or in it, it is Ember (fill) or Ember Text (type), never Effort Orange.",
        "section": "colors"
      },
      {
        "name": "The Every Surface Rule",
        "body": "A text color is approved only after it measures ≥4.5:1 on *every* surface it can sit on (Surface White, Chalk, Chalk Dust, and any wash), not just white. Two tokens once shipped that passed on white only.",
        "section": "colors"
      },
      {
        "name": "The Effort Rule",
        "body": "Orange marks effort and the one primary action on a screen. A screen with orange in more than a handful of places has lost its signal.",
        "section": "colors"
      },
      {
        "name": "The Tabular Rule",
        "body": "Any number that changes or aligns with others uses tabular figures (`fontVariant: [\"tabular-nums\"]`), so \"82.5\" and \"100\" take the same width per digit and timers don't jitter.",
        "section": "typography"
      },
      {
        "name": "The Text Scale Rule",
        "body": "Text follows the OS text-size setting. Content scales fully; text inside fixed-width slots is capped with `maxFontSizeMultiplier`: chrome (tab labels, column headers, badges, stat labels) at 1.3×, numbers inside fixed controls and already-huge display text at 1.6×. In narrow slots, prefer `numberOfLines={1}` + `adjustsFontSizeToFit` over wrapping mid-word.",
        "section": "typography"
      },
      {
        "name": "The Soft Lift Rule",
        "body": "Shadows only say \"this is a separate object\". They never get bigger to signal importance; importance comes from color and size.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use semantic color roles from `@/theme` (`surface`, `textMuted`, `primaryText`) and `makeStyles`, never hex values in screens.",
      "Do put white text only on Ember (4.59:1) or the hero gradient.",
      "Do measure every new text/background pair on every surface it can sit on, in both themes, before shipping it.",
      "Do keep every touch target at least `MIN_TOUCH` (44pt iOS / 48dp Android).",
      "Do use tabular figures for any number that changes or sits in a column.",
      "Do respect Reduce Motion: springs and fills jump straight to their end state.",
      "Do give every screen loading, empty and error (with retry) states built from the shared components.",
      "Do say what a number counts when it isn't obvious (e.g. \"Only workouts you can see are counted\"), as Progress and Leaderboard do."
    ],
    "donts": [
      "Don't put text on Effort Orange (3.12:1); it is for graphics only.",
      "Don't add a second typeface or a second icon set (Ionicons is the only one).",
      "Don't use shadows to signal importance or rely on them in dark mode.",
      "Don't set a fixed `height` on anything that contains text; use `minHeight` so large text grows the control.",
      "Don't use confetti or celebration for anything but a real personal record; rarity is what makes it mean something.",
